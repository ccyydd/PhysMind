{
  "schema_version": 2,
  "profile_set_id": "physmind_route_modules_v2",
  "shared_modules": {
    "artifact_identity": {
      "implementation": "physionpp_tracking_artifact_contract",
      "parameters": {
        "concept_id": "physion_pp_gdino_visual_prompt",
        "cue_trimmed_suffix": "_cue_trimmed.mp4",
        "cue_flash_suffix": "_cue_flash.npz",
        "static_track_prefix": "physion_pp_static_"
      }
    },
    "gdino_cleanup": {
      "implementation": "area_edge_filter_then_same_label_nms",
      "parameters": {
        "confidence": 0.25,
        "area_cap_fraction": 0.6,
        "same_label_nms_iou": 0.5,
        "edge_margin_px": 2,
        "edge_sides_to_drop": 3
      }
    },
    "sam3_mask_filter": {
      "implementation": "anchor_probe_area_and_iou_filter",
      "parameters": {
        "f0_dedup_iou": 0.75,
        "minimum_area_px": 20
      }
    },
    "same_object_merge": {
      "implementation": "overlap_relay_comotion_evidence",
      "parameters": {
        "overlap_min_shared_frames": 5,
        "overlap_iou": 0.75,
        "relay_coexist_fraction": 0.3,
        "relay_gap_frames": 5,
        "relay_centroid_px": 12.0,
        "comotion_min_shared_frames": 10,
        "comotion_min_displacement_px": 25.0,
        "comotion_dilate_px": 5,
        "comotion_contact_fraction": 0.6,
        "comotion_distance_std_px": 3.0,
        "default_evidence": ["overlap", "relay", "comotion"]
      }
    },
    "cue_role_binding": {
      "implementation": "cue_flash_track_coverage_with_motion_tie_break",
      "parameters": {
        "minimum_coverage": 0.3,
        "tie_margin": 0.2
      }
    },
    "static_role_assignment": {
      "implementation": "mask_centroid_net_displacement",
      "parameters": {
        "maximum_displacement_px": 10.0
      }
    },
    "sam3_priority": {
      "implementation": "separate_sessions_then_pixel_priority_carve",
      "parameters": {
        "solo_red_class_keyword": "red"
      }
    }
  },
  "route_profiles": {
    "tracking.gdino_role_box_point": {
      "decision_id": "TRK-001.tracking_family",
      "route": "tracking.gdino_role_box_point",
      "benchmark": "physion_pp",
      "scenarios": ["friction_platform_pp"],
      "modules": {
        "detector": {
          "implementation": "gdino_role_specific_multi_round",
          "parameters": {
            "rounds": [
              {"name": "red", "query": "red object", "confidence": 0.4, "prompt_mode": "box", "session": "solo"},
              {"name": "yellow", "query": "small yellow patch", "confidence": 0.4, "prompt_mode": "point", "session": "solo"},
              {"name": "house", "query": "large house-shaped block", "confidence": 0.55, "prompt_mode": "box", "session": "structure"},
              {"name": "long_ramp", "query": "large wedge ramp", "confidence": 0.65, "prompt_mode": "box", "session": "structure"},
              {"name": "small_wedge", "query": "small wedge ramp", "confidence": 0.2, "prompt_mode": "box", "session": "structure"}
            ],
            "cross_round_merge_iou": 0.7,
            "cross_round_merge_containment": 0.85
          }
        },
        "sam3_seed": {
          "implementation": "solo_red_box_solo_yellow_point_joint_structure_boxes",
          "parameters": {
            "anchor_source": "cli_prompt_frame_index",
            "pixel_priority": ["red", "yellow", "structure"]
          }
        },
        "postprocess": {
          "implementation": "priority_carve_fragment_cleanup_structure_merge",
          "parameters": {
            "fragment_minimum_area_px": 20,
            "fragment_minimum_largest_fraction": 0.005,
            "same_object_merge_evidence": ["overlap", "relay"]
          }
        },
        "role_binding": {
          "implementation": "cue_flash_red_agent_yellow_patient",
          "parameters": {}
        }
      }
    },
    "tracking.gdino_per_part_seeds": {
      "decision_id": "TRK-001.tracking_family",
      "route": "tracking.gdino_per_part_seeds",
      "benchmark": "physion_pp",
      "scenarios": ["bouncy_platform_pp"],
      "modules": {
        "detector": {
          "implementation": "gdino_per_part_targeted_rounds",
          "parameters": {
            "vocabulary": ["small dark red block", "large dark wooden platform", "wooden frame", "yellow mat", "green mat", "teal mat", "mat"],
            "agent_query": "small red block",
            "agent_confidence": 0.15,
            "agent_max_side_px": 32,
            "big_block_query": "large dark box",
            "big_block_confidence": 0.15,
            "static_drop_words": ["red", "yellow"],
            "reference_containment": 0.8
          }
        },
        "sam3_seed": {
          "implementation": "agent_point_other_parts_box_both_direction",
          "parameters": {
            "anchor_frame": 60,
            "agent_fallback_frames": [50, 70, 40, 80, 30],
            "mask_containment": 0.8,
            "pixel_priority": ["agent", "yellow", "other"]
          }
        },
        "postprocess": {
          "implementation": "anchor_probe_keep_big_containment",
          "parameters": {}
        },
        "role_binding": {
          "implementation": "cue_flash_red_agent_yellow_patient",
          "parameters": {}
        }
      }
    },
    "tracking.gdino_two_segment_point_probe": {
      "decision_id": "TRK-001.tracking_family",
